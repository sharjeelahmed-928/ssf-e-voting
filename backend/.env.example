# Database connection (Neon / Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/ssf_evoting

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_EXPIRY_HOURS=24

# Flask
FLASK_ENV=production
SECRET_KEY=change-this-too

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5500

# Default Super Admin (created automatically on first run if no admin exists)
SUPERADMIN_SSF_ID=SSFADMIN
SUPERADMIN_CNIC=0000000000000
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=SSF_Admin360
